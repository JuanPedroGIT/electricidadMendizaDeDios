    "/api/internal/contacts/pending": {
      "get": {
        "tags": ["Interno"],
        "summary": "Contactos pendientes de notificar",
        "operationId": "getPendingContacts",
        "security": [
          { "internalApiKey": [] }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
