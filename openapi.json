          "200": {
            "description": "Configuración del sitio",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": { "$ref": "#/components/schemas/SiteSettings" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/faq": {
      "get": {
        "tags": ["Público"],
