{
  "openapi": "3.0.3",
  "info": {
    "title": "Electricidad Mendoza de Dios API",
    "description": "API pública, de administración e interna para Electricidad Mendoza de Dios. Incluye gestión de servicios, FAQ, contactos, configuración del sitio y health checks.",
    "version": "1.0.0",
    "contact": {
      "name": "Electricidad Mendoza de Dios",
      "email": "info@electricidadmendozadedios.es",
      "url": "https://electricidadmendozadedios.es"
    }
  },
  "servers": [
    {
      "url": "https://electricidadmendozadedios.online",
      "description": "Producción"
    }
  ],
  "tags": [
    {
      "name": "Público",
      "description": "Endpoints accesibles sin autenticación"
    },
    {
      "name": "Administración",
      "description": "Endpoints protegidos por sesión de administrador"
    },
    {
      "name": "Interno",
      "description": "Endpoints para automatización interna (n8n). Requieren API Key."
    },
    {
      "name": "Sistema",
      "description": "Health checks y estado del sistema"
    }
  ],
  "paths": {
    "/api/services": {
      "get": {
        "tags": ["Público"],
        "summary": "Listar servicios",
        "operationId": "listServices",
        "responses": {
          "200": {
            "description": "Lista de servicios",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Service" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/services/{slug}": {
      "get": {
        "tags": ["Público"],
        "summary": "Detalle de un servicio",
        "operationId": "getServiceBySlug",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Detalle del servicio",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": { "$ref": "#/components/schemas/Service" }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Servicio no encontrado",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/api/site-settings/public": {
      "get": {
        "tags": ["Público"],
        "summary": "Configuración pública del sitio",
        "operationId": "getPublicSiteSettings",
