  "components": {
    "schemas": {
      "Service": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "slug": { "type": "string" },
          "name": { "type": "string" },
          "summary": { "type": "string" },
          "benefits": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "required": ["id", "slug", "name", "summary", "benefits"]
      },
      "ServicePayload": {
        "type": "object",
        "properties": {
          "slug": { "type": "string" },
          "name": { "type": "string" },
          "summary": { "type": "string" },
          "benefits": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "required": ["slug", "name", "summary", "benefits"]
      },
      "Faq": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "question": { "type": "string" },
          "answer": { "type": "string" }
        },
        "required": ["id", "question", "answer"]
      },
      "FaqPayload": {
        "type": "object",
        "properties": {
          "question": { "type": "string" },
          "answer": { "type": "string" }
        },
        "required": ["question", "answer"]
      },
      "SiteSettings": {
        "type": "object",
        "properties": {
          "brand": { "type": "string" },
          "tagline": { "type": "string" },
          "phone": { "type": "string" },
          "phone_display": { "type": "string" },
          "whatsapp": { "type": "string" },
          "email": { "type": "string" },
          "address": { "type": "string" },
          "cta": { "type": "string" }
        },
        "required": ["brand", "tagline", "phone", "phone_display", "whatsapp", "email", "address", "cta"]
      },
      "SiteSettingsPayload": {
        "type": "object",
        "properties": {
          "brand": { "type": "string" },
          "tagline": { "type": "string" },
          "phone": { "type": "string" },
          "phone_display": { "type": "string" },
          "whatsapp": { "type": "string" },
          "email": { "type": "string" },
          "address": { "type": "string" },
          "cta": { "type": "string" }
        },
        "required": ["brand", "tagline", "phone", "phone_display", "whatsapp", "email", "address", "cta"]
      },
      "ContactPayload": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 2 },
          "phone": {
            "type": "string",
            "pattern": "^[0-9+\\s-]{6,20}$"
          },
          "email": { "type": "string", "format": "email", "nullable": true },
          "type": { "type": "string", "nullable": true },
          "area": { "type": "string", "nullable": true },
          "message": { "type": "string", "nullable": true }
        },
        "required": ["name", "phone"]
      },
      "ContactLead": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "phone": { "type": "string" },
          "email": { "type": "string", "nullable": true },
          "type": { "type": "string", "nullable": true },
          "area": { "type": "string", "nullable": true },
          "message": { "type": "string", "nullable": true },
          "ip": { "type": "string", "nullable": true },
          "userAgent": { "type": "string", "nullable": true },
          "createdAt": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "name", "phone", "createdAt"]
      },
      "HealthStatus": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["healthy", "unhealthy"] },
          "timestamp": { "type": "string", "format": "date-time" },
          "checks": {
            "type": "object",
            "properties": {
              "database": { "$ref": "#/components/schemas/HealthCheck" },
              "redis": { "$ref": "#/components/schemas/HealthCheck" },
              "mailer": { "$ref": "#/components/schemas/HealthCheck" }
            }
          }
        },
        "required": ["status", "timestamp", "checks"]
      },
      "HealthCheck": {
        "type": "object",
        "properties": {
          "healthy": { "type": "boolean", "nullable": true },
          "message": { "type": "string", "nullable": true },
          "error": { "type": "string", "nullable": true },
          "response_time_ms": { "type": "number", "nullable": true }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": { "type": "string" }
        },
        "required": ["error"]
      },
      "ValidationError": {
        "type": "object",
        "properties": {
          "errors": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          }
        },
        "required": ["errors"]
      }
    },
    "securitySchemes": {
      "sessionAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "PHPSESSID",
        "description": "Sesión de administrador gestionada por Symfony. Se establece tras el login exitoso."
      },
      "csrfToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRF-TOKEN",
        "description": "Token CSRF devuelto en el login. Obligatorio en operaciones de escritura (POST, PUT, PATCH, DELETE) del panel de administración."
      },
      "internalApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Internal-Api-Key",
        "description": "Clave API para endpoints internos utilizados por n8n."
      }
    }
  }
}
